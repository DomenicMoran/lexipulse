{
  "name": "@lexipulse/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf .next .turbo out",
    "prebuild": "node scripts/generate-legal.mjs && node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/generate-legal.mjs && node scripts/copy-pdfjs-assets.mjs",
    "pretypecheck": "node scripts/generate-legal.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.8.4",
    "@lexipulse/core": "workspace:*",
    "@lexipulse/pdf": "workspace:*",
    "@lexipulse/ui": "workspace:*",
    "clsx": "2.1.1",
    "framer-motion": "13.1.0",
    "idb": "8.0.3",
    "next": "15.5.23",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "eslint-plugin-react-hooks": "7.1.1",
    "rimraf": "6.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
