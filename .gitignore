# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# The brand vectors are a deliverable, not a build artefact — they get linked from the
# README and handed to third parties, so they belong in the repository.
!/packages/assets/out/
!/packages/assets/out/**

# expo — anchored on purpose: a bare "android/" would also swallow any unrelated
# directory of that name anywhere in the tree.
.expo/
.expo-shared/
/apps/mobile/android/
/apps/mobile/ios/
*.apk
*.aab
*.ipa

# env
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel/

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test
coverage/

# Local verification artefacts: browser screenshots and sample documents produced while
# checking a change. Regenerated on demand, never referenced by the product.
.verify/
.playwright-mcp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*
