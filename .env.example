# LexiPulse — Beispielumgebung. Echte Werte gehören in .env.local (gitignoriert).
# Diese Schlüssel sind nur für Store-Einreichung und Deploy nötig; die App
# selbst läuft ohne sie.

# ── Apple (App Store / App Store Connect API) ────────────────────────────────
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_KEY_PATH=

# ── Google Play ───────────────────────────────────────────────────────────────
PLAY_PACKAGE=
PLAY_SERVICE_ACCOUNT=

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_OIDC_TOKEN=
