{
  "name": "@lexipulse/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./geometry": "./src/player-geometry.ts",
    "./components": "./src/components/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@lexipulse/core": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
