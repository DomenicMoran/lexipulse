{
  "name": "@lexipulse/pdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry.ts",
    "./export": "./src/export.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.8.4",
    "@lexipulse/core": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=5",
    "react": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.3",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
