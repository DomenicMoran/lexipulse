{
  "name": "@lexipulse/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./parsers": "./src/parsers/index.ts",
    "./storage": "./src/storage/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
